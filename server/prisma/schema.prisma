// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider        = "prisma-client-js"
  output          = "../generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis]
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum PaymentStatus {
  PENDING
  PAID
}

model User {
  id          String     @id @default(uuid())
  // Clerk handles sign-in; this links the rider to their Clerk account.
  clerkId     String     @unique
  name        String?
  email       String?    @unique
  status      UserStatus @default(ACTIVE)
  phoneNumber String?    @unique
  upiId       String?

  rides            Ride[]        @relation("RideUsers")
  createdRides     Ride[]        @relation("RideCreator")
  chats            Chat[]
  sentMessages     Message[]
  paymentsSent     Payment[]     @relation("PaymentFrom")
  paymentsReceived Payment[]     @relation("PaymentTo")
  joinRequests     JoinRequest[]
}

model Ride {
  id              String                                @id @default(uuid())
  paymentStatus   PaymentStatus                         @default(PENDING)
  joinable        Boolean                               @default(true)
  // [lon, lat] via ST_MakePoint(lon, lat); written with raw SQL
  source          Unsupported("geography(Point, 4326)")
  time            DateTime
  destination     Unsupported("geography(Point, 4326)")
  // Readable place names, e.g. "Rishihood University, Sonipat"
  sourceName      String
  destinationName String
  rideCreatorId   String

  rideCreator  User          @relation("RideCreator", fields: [rideCreatorId], references: [id])
  users        User[]        @relation("RideUsers")
  chat         Chat?
  payments     Payment[]
  joinRequests JoinRequest[]
}

model Chat {
  id       String    @id @default(uuid())
  rideId   String    @unique
  ride     Ride      @relation(fields: [rideId], references: [id], onDelete: Cascade)
  users    User[]
  messages Message[]
  payments Payment[]
}

model Message {
  id        String   @id @default(uuid())
  senderId  String
  chatId    String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sender User @relation(fields: [senderId], references: [id])
  chat   Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)
}

model Payment {
  id     String        @id @default(uuid())
  fromId String
  toId   String
  rideId String
  chatId String
  status PaymentStatus @default(PENDING)
  amount Decimal

  from User @relation("PaymentFrom", fields: [fromId], references: [id])
  to   User @relation("PaymentTo", fields: [toId], references: [id])
  ride Ride @relation(fields: [rideId], references: [id], onDelete: Cascade)
  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)
}

enum JoinRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
}

// A rider asks to join a ride; the ride creator accepts or rejects it.
// Holds the requester's own stops, so the creator can see them on the map
// and, once accepted, it records where that member gets on and off.
model JoinRequest {
  id              String                                @id @default(uuid())
  rideId          String
  userId          String
  status          JoinRequestStatus                     @default(PENDING)
  // [lon, lat] via ST_MakePoint(lon, lat); written with raw SQL
  pickup          Unsupported("geography(Point, 4326)")
  pickupName      String
  destination     Unsupported("geography(Point, 4326)")
  destinationName String
  createdAt       DateTime                              @default(now())
  respondedAt     DateTime?

  ride Ride @relation(fields: [rideId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])
}
