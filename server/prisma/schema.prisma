// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider        = "prisma-client-js"
  output          = "../generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis]
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum PaymentStatus {
  PENDING
  PAID
}

model User {
  id          String     @id @default(uuid()) @db.Uuid
  name        String
  email       String?    @unique
  status      UserStatus @default(ACTIVE)
  password    String
  phoneNumber String?    @unique @map("phone_number")
  upiId       String?    @map("upi_id")

  rides            Ride[]    @relation("RideUsers")
  createdRides     Ride[]    @relation("RideCreator")
  chats            Chat[]
  sentMessages     Message[]
  paymentsSent     Payment[] @relation("PaymentFrom")
  paymentsReceived Payment[] @relation("PaymentTo")
}

model Ride {
  id            String                                @id @default(uuid()) @db.Uuid
  paymentStatus PaymentStatus                         @default(PENDING) @map("payment_status")
  joinable      Boolean                               @default(true)
  // [lon, lat] via ST_MakePoint(lon, lat); written with raw SQL
  source        Unsupported("geography(Point, 4326)")
  time          DateTime                              @db.Timestamptz
  destination   Unsupported("geography(Point, 4326)")
  rideCreatorId String                                @map("ride_creator_id") @db.Uuid

  rideCreator User      @relation("RideCreator", fields: [rideCreatorId], references: [id])
  users       User[]    @relation("RideUsers")
  chat        Chat?
  payments    Payment[]
}

model Chat {
  id     String @id @default(uuid()) @db.Uuid
  rideId String @unique @map("ride_id") @db.Uuid

  ride     Ride      @relation(fields: [rideId], references: [id], onDelete: Cascade)
  users    User[]
  messages Message[]
  payments Payment[]
}

model Message {
  id        String   @id @default(uuid()) @db.Uuid
  senderId  String   @map("sender_id") @db.Uuid
  chatId    String   @map("chat_id") @db.Uuid
  content   String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  sender User @relation(fields: [senderId], references: [id])
  chat   Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)
}

model Payment {
  id     String        @id @default(uuid()) @db.Uuid
  fromId String        @map("from_id") @db.Uuid
  toId   String        @map("to_id") @db.Uuid
  rideId String        @map("ride_id") @db.Uuid
  chatId String        @map("chat_id") @db.Uuid
  status PaymentStatus @default(PENDING)
  amount Decimal       @db.Decimal(10, 2)

  from User @relation("PaymentFrom", fields: [fromId], references: [id])
  to   User @relation("PaymentTo", fields: [toId], references: [id])
  ride Ride @relation(fields: [rideId], references: [id], onDelete: Cascade)
  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)
}
