{
  "expo": {
    "name": "HopShare",
    "slug": "hopshare",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "hopshare",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.hopshare.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#c6f36b",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.hopshare.app",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#f6f7f2",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 88,
          "dark": {
            "backgroundColor": "#0f1412",
            "image": "./assets/images/splash-icon-dark.png"
          }
        }
      ],
      "expo-secure-store",
      "@clerk/expo",
      "expo-web-browser",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "HopShare uses your location to set your pickup point and find riders near you."
        }
      ],
      "@maplibre/maplibre-react-native",
      "expo-image",
      "expo-status-bar",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/android-icon-monochrome.png",
          "color": "#3d6b00"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "owner": "yatinsingh2007",
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "a6016600-9039-47dc-bdba-dc1b34a63e12"
      }
    }
  }
}
